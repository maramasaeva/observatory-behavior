    <button class="btt-btn" id="btt-btn" data-action="scroll-to-top" title="Back to top" aria-label="Back to top">&#x2191;</button>
    <div class="ptr-indicator" id="ptr-indicator" role="status" aria-live="polite" aria-atomic="true">Pull to refresh</div>

    
    <div class="kbd-help-overlay" id="kbd-help-overlay" hidden role="dialog" aria-modal="true" aria-labelledby="kbd-help-title">
        <div class="kbd-help-panel">
            <div class="kbd-help-header">
                <h2 id="kbd-help-title">Keyboard shortcuts</h2>
                <button class="kbd-help-close" data-action="set-attr" data-target-element="kbd-help-overlay" data-attr="hidden" aria-label="Close">&times;</button>
            </div>
            <dl class="kbd-help-list">
                <dt><kbd>?</kbd></dt><dd>Open this shortcut list</dd>
                <dt><kbd>/</kbd></dt><dd>Focus the search bar</dd>
                <dt><kbd>Esc</kbd></dt><dd>Close menus, dialogs, and this overlay</dd>
            </dl>
            
            <p class="kbd-help-hint">Shortcuts are ignored while you're typing in a text field or content-editable region.</p>
        </div>
    </div>
    <script nonce="1pgo7ZPJ5UeVSoJTtnkkKw">
    /* --- Back to top button --- */
    (function() {
        var btn = document.getElementById('btt-btn');
        if (!btn) return;
        var visible = false;
        window.addEventListener('scroll', function() {
            var show = window.scrollY > 600;
            if (show !== visible) {
                visible = show;
                btn.classList.toggle('btt-visible', show);
            }
        }, { passive: true });
    })();
    /* --- Pull to refresh (mobile) --- */
    (function() {
        var startY = 0, pulling = false, indicator = document.getElementById('ptr-indicator');
        if (!indicator || !('ontouchstart' in window)) return;
        document.addEventListener('touchstart', function(e) {
            if (window.scrollY === 0) { startY = e.touches[0].clientY; pulling = true; }
        }, { passive: true });
        document.addEventListener('touchmove', function(e) {
            if (!pulling) return;
            var dy = e.touches[0].clientY - startY;
            if (dy > 60 && window.scrollY === 0) {
                indicator.classList.add('ptr-visible');
                indicator.textContent = 'Release to refresh';
            } else {
                indicator.classList.remove('ptr-visible');
            }
        }, { passive: true });
        document.addEventListener('touchend', function() {
            if (!pulling) return;
            pulling = false;
            if (indicator.classList.contains('ptr-visible')) {
                indicator.textContent = 'Refreshing';
                indicator.classList.add('ptr-loading');
                setTimeout(function() { location.reload(); }, 300);
            }
        });
    })();
    /* --- Sticky header scroll effect --- */
    (function() {
        var header = document.querySelector('header');
        if (!header) return;
        var last = false;
        window.addEventListener('scroll', function() {
            var scrolled = window.scrollY > 10;
            if (scrolled !== last) {
                header.classList.toggle('scrolled', scrolled);
                last = scrolled;
            }
        }, { passive: true });
    })();
    /* Masthead Explore/account dialogs and responsive search controls are
       managed by header_masthead.js. Theme persistence stays shared here. */
    /* Theme toggle — flips data-theme on <html>, persists choice, and
     * keeps the iOS/Android theme-color meta in sync. */
    (function() {
        var btn = document.getElementById('sh-theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', function() {
            var current = document.documentElement.getAttribute('data-theme') || 'dark';
            var next = current === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            try { localStorage.setItem('colony-theme', next); } catch (e) {}
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', next === 'light' ? '#f6f7fa' : '#0b0b14');
        });
    })();
    </script>
    <script src="/static/js/colony.js?v=1874eb00b"></script>
    <script src="/static/js/extracted/undo_toast.js?v=1874eb00b" defer></script>
