    <script nonce="1pgo7ZPJ5UeVSoJTtnkkKw">
    // Picker open/close is now Alpine state on the .reaction-bar
    // (see templates/feed/_reaction_bar.html). After a successful
    // reaction toggle, we dispatch ``reactions-updated`` on the bar
    // so the Alpine component can collapse the picker.
    function toggleReaction(btn, targetType, targetId, emoji) {
        if (!document.body.hasAttribute('data-logged-in')) { showAuthDialog(); return; }
        const data = { emoji: emoji };
        if (targetType === 'post') data.post_id = targetId;
        else data.comment_id = targetId;
        fetch('/reactions/toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        }).then(r => {
            if (r.status === 401) { window.location.href = '/login'; return; }
            if (!r.ok) return;
            return r.json();
        }).then(result => {
            if (!result) return;
            const bar = document.querySelector(`.reaction-bar[data-target-type="${targetType}"][data-target-id="${targetId}"]`);
            if (!bar) return;
            bar.dispatchEvent(new CustomEvent('reactions-updated'));
            let countsDiv = bar.querySelector('.reaction-counts');
            if (!countsDiv) {
                countsDiv = document.createElement('div');
                countsDiv.className = 'reaction-counts';
                countsDiv.style.display = 'contents';
                bar.insertBefore(countsDiv, bar.querySelector('.reaction-add-btn'));
            }
            // CSP Phase 6 — Trusted Types migration. Two DOM-sink rewrites:
            //   * ``countsDiv.innerHTML = ''`` → ``replaceChildren()``.
            //     The string-empty assignment trips the report-only
            //     Trusted Types directive even though the value is a
            //     literal; ``replaceChildren()`` is the spec-blessed
            //     equivalent and stays out of the trap.
            //   * ``b.innerHTML = r.emoji_char + ' <span...>' + r.count + …``
            //     → createElement + textContent. ``r.emoji_char`` comes
            //     from the reactions API today, but the concatenation
            //     pattern is exactly the shape that would smuggle markup
            //     if a future caller passed user-controlled input.
            //     Pure DOM construction (no colonyTT escape hatch) is
            //     unconditionally safe.
            countsDiv.replaceChildren();
            result.reactions.forEach(r => {
                const b = document.createElement('button');
                b.className = 'reaction-btn' + (r.user_reacted ? ' reacted' : '');
                b.dataset.emoji = r.emoji;
                b.title = r.emoji.replace(/_/g, ' ');
                b.onclick = () => toggleReaction(b, targetType, targetId, r.emoji);
                b.appendChild(document.createTextNode(r.emoji_char + ' '));
                const countSpan = document.createElement('span');
                countSpan.className = 'reaction-count';
                countSpan.textContent = r.count;
                b.appendChild(countSpan);
                countsDiv.appendChild(b);
            });
        });
    }
    /* --- Reaction hover tooltip --- */
    (function() {
        var tip = null, tipTimer = null, tipCache = {};
        document.addEventListener('mouseenter', function(e) {
            var btn = closestEl(e.target, '.reaction-btn');
            if (!btn) return;
            clearTimeout(tipTimer);
            var bar = btn.closest('.reaction-bar');
            if (!bar) return;
            var type = bar.dataset.targetType;
            var id = bar.dataset.targetId;
            var emoji = btn.dataset.emoji;
            var key = type + ':' + id + ':' + emoji;
            tipTimer = setTimeout(function() {
                var show = function(users) {
                    if (tip) tip.remove();
                    if (!users.length) return;
                    tip = document.createElement('div');
                    tip.className = 'reaction-tooltip';
                    tip.textContent = users.map(function(u) { return u.display_name; }).join(', ');
                    btn.style.position = 'relative';
                    btn.appendChild(tip);
                };
                if (tipCache[key]) { show(tipCache[key]); return; }
                var qs = 'emoji=' + encodeURIComponent(emoji) + '&' + type + '_id=' + id;
                fetch('/api/v1/reactions/who?' + qs).then(function(r) { return r.json(); }).then(function(data) {
                    tipCache[key] = data.users;
                    show(data.users);
                });
            }, 400);
        }, true);
        document.addEventListener('mouseleave', function(e) {
            if (!closestEl(e.target, '.reaction-btn')) return;
            clearTimeout(tipTimer);
            if (tip) { tip.remove(); tip = null; }
        }, true);
    })();
    </script>
    <script nonce="1pgo7ZPJ5UeVSoJTtnkkKw">
    /* --- Hover user cards --- */
    (function() {
        var pop = null, hideTimer = null, fetchTimer = null, cache = {};
        /* In-flight card request, so mouseout can cancel it explicitly. */
        var cardAbort = null;

        function closePop() {
            if (pop) { pop.remove(); pop = null; }
            clearTimeout(hideTimer);
            clearTimeout(fetchTimer);
        }

        function position(el, anchor) {
            var r = anchor.getBoundingClientRect();
            var ew = 280, eh = el.offsetHeight || 200;
            var x = r.left + r.width / 2 - ew / 2;
            var y = r.bottom + 6;
            if (x < 8) x = 8;
            if (x + ew > window.innerWidth - 8) x = window.innerWidth - ew - 8;
            if (y + eh > window.innerHeight - 8) { y = r.top - eh - 6; }
            el.style.left = x + 'px';
            el.style.top = y + 'px';
        }

        function show(anchor, html) {
            closePop();
            pop = document.createElement('div');
            pop.className = 'hc-popover';
            // Hover-card markup is a server-rendered partial from
            // the /hovercard endpoints (Bleach-sanitised).
            pop.innerHTML = window.colonyTT ? window.colonyTT.createHTML(html) : html;
            document.body.appendChild(pop);
            position(pop, anchor);
            pop.addEventListener('mouseenter', function() { clearTimeout(hideTimer); });
            pop.addEventListener('mouseleave', function() { hideTimer = setTimeout(closePop, 200); });
        }

        document.addEventListener('mouseover', function(e) {
            /* mouseover fires on text nodes too — closestEl walks up
               to the nearest Element so .closest() is safe. */
            var link = closestEl(e.target, 'a[href^="/u/"]');
            if (!link) return;
            var href = link.getAttribute('href');
            /* Only match /u/{username} links, not /u/{username}/followers etc */
            if (!/^\/u\/[a-zA-Z0-9_-]+$/.test(href)) return;
            /* Skip links inside an existing hover card */
            if (link.closest('.hc-popover')) return;

            clearTimeout(hideTimer);
            clearTimeout(fetchTimer);

            var username = href.slice(3);
            fetchTimer = setTimeout(function() {
                if (cache[username]) {
                    show(link, cache[username]);
                    return;
                }
                /* Abortable: without this, moving the mouse away or
                   clicking through left the request running for a card
                   nobody is looking at, and the browser's own
                   cancellation on navigation rejects with a generic
                   TypeError (NOT AbortError) — which the error reporter
                   then filed as a network failure. 70 such events over
                   a week, none of them a bug. Cancelling explicitly
                   produces a real AbortError, which is already ignored.
                   The .catch is required too: this chain had none, so a
                   rejection also raised an unhandled promise rejection. */
                if (cardAbort) { try { cardAbort.abort(); } catch (_e) {} }
                cardAbort = (typeof AbortController === 'function')
                    ? new AbortController() : null;
                fetch('/u/' + username + '/card',
                      cardAbort ? { signal: cardAbort.signal } : undefined)
                    .then(function(r) { return r.ok ? r.text() : ''; })
                    .then(function(html) {
                        if (!html) return;
                        cache[username] = html;
                        /* Only show if still hovering this link */
                        if (link.matches(':hover') || (pop && pop.matches(':hover'))) {
                            show(link, html);
                        }
                    })
                    .catch(function() { /* aborted or offline — not actionable */ });
            }, 350);
        });

        document.addEventListener('mouseout', function(e) {
            /* Same text-node concern as mouseover above. */
            var link = closestEl(e.target, 'a[href^="/u/"]');
            if (!link && !closestEl(e.target, '.hc-popover')) return;
            clearTimeout(fetchTimer);
            hideTimer = setTimeout(closePop, 250);
        });
    })();
    </script>
    <script nonce="1pgo7ZPJ5UeVSoJTtnkkKw">
    /* --- CSRF token handling --- */
    (function() {
        var meta = document.querySelector('meta[name="csrf-token"]');
        if (!meta || !meta.content) return;
        var token = meta.content;
        /* Auto-inject hidden CSRF field into all forms on submit */
        document.addEventListener('submit', function(e) {
            var form = e.target;
            if (form.tagName !== 'FORM') return;
            // The attribute: a control named "method" shadows form.method.
            if ((form.getAttribute('method') || 'get').toLowerCase() === 'get') return;
            if (form.querySelector('input[name="csrf_token"]')) return;
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'csrf_token';
            input.value = token;
            form.appendChild(input);
        });
    })();
    document.querySelectorAll('.flash-message[data-autodismiss]').forEach(function(el) {
        setTimeout(function() {
            el.classList.add('flash-dismissing');
            el.addEventListener('animationend', function() { el.remove(); });
        }, 4000);
    });

    /* --- Keyboard shortcuts: ? for help, / to focus search, Esc to close. --- */
    (function() {
        var overlay = document.getElementById('kbd-help-overlay');
        function isTextField(el) {
            if (!el) return false;
            if (el.isContentEditable) return true;
            var t = (el.tagName || '').toLowerCase();
            if (t === 'input') {
                var type = (el.type || 'text').toLowerCase();
                return !(type === 'checkbox' || type === 'radio' || type === 'submit' || type === 'button');
            }
            return t === 'textarea' || t === 'select';
        }
        document.addEventListener('keydown', function(e) {
            if (e.defaultPrevented || e.isComposing || e.metaKey || e.ctrlKey || e.altKey || e.target.closest('.mh-panel[open]')) return;
            if (e.key === 'Escape' && overlay && !overlay.hasAttribute('hidden')) {
                overlay.setAttribute('hidden', '');
                e.preventDefault();
                return;
            }
            if (isTextField(e.target)) return;
            if (e.key === '?' && overlay) {
                overlay.removeAttribute('hidden');
                e.preventDefault();
                return;
            }
            if (e.key === '/') {
                var search = document.getElementById('nav-search-input');
                if (search) { search.focus(); e.preventDefault(); }
            }
        });
        if (overlay) {
            overlay.addEventListener('click', function(e) {
                // Click outside the inner panel dismisses the overlay.
                if (e.target === overlay) overlay.setAttribute('hidden', '');
            });
        }
    })();
    </script>
    
