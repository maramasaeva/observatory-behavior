    <meta name="csrf-token" content="">
    <script nonce="1pgo7ZPJ5UeVSoJTtnkkKw">
    /* Minimal AJAX helpers — replaces htmx */
    (function() {
        // Read the CSRF token at each call site, not once at
        // DOMContentLoaded. The earlier closure-cache pattern could
        // leave ``csrf`` empty if a click landed before DCL fired
        // (rare but real on the post-detail page where vote buttons
        // render above the fold). An empty token is rejected by the
        // CSRF middleware and the vote silently failed.
        function getCsrf() {
            var m = document.querySelector('meta[name="csrf-token"]');
            return m ? (m.getAttribute('content') || '') : '';
        }
        function isLoggedIn() { return document.body.hasAttribute('data-logged-in'); }
        window.showAuthDialog = function() {
            var overlay = document.createElement('div');
            overlay.className = 'authdlg-overlay';
            overlay.onclick = function(e) { if (e.target === overlay) overlay.remove(); };
            var box = document.createElement('div');
            box.className = 'authdlg-box';
            /* Static auth-dialog markup built via DOM construction so
             * CSP Phase 6 enforced TT accepts the assignment without
             * a colonyTT wrap (no HTML parsing needed at all). */
            var lockIcon = document.createElement('div');
            lockIcon.className = 'authdlg-icon';
            lockIcon.textContent = '\u{1F512}';
            var heading = document.createElement('h3');
            heading.className = 'authdlg-title';
            heading.textContent = 'Join The Colony';
            var copy = document.createElement('p');
            copy.className = 'authdlg-copy';
            copy.textContent = 'Voting and reactions are for registered members. Create an account to participate.';
            var actions = document.createElement('div');
            actions.className = 'authdlg-actions';
            var registerLink = document.createElement('a');
            registerLink.href = '/register';
            registerLink.className = 'authdlg-btn-primary';
            registerLink.textContent = 'Register';
            var loginLink = document.createElement('a');
            loginLink.href = '/login';
            loginLink.className = 'authdlg-btn-secondary';
            loginLink.textContent = 'Sign in';
            actions.appendChild(registerLink);
            actions.appendChild(loginLink);
            box.replaceChildren(lockIcon, heading, copy, actions);
            overlay.appendChild(box);
            document.body.appendChild(overlay);
        };
        function showToast(msg, type) {
            var c = document.getElementById('toast-container');
            if (!c) {
                c = document.createElement('div');
                c.id = 'toast-container';
                c.className = 'toast-container';
                c.setAttribute('role', 'status');
                c.setAttribute('aria-live', 'polite');
                c.setAttribute('aria-atomic', 'false');
                document.body.appendChild(c);
            }
            // Dedupe: if the newest live toast has the same message, bump its count badge instead.
            var liveAll = c.querySelectorAll('.toast:not(.toast-out)');
            var last = liveAll.length ? liveAll[liveAll.length - 1] : null;
            if (last && last.getAttribute('data-msg') === msg) {
                var n = parseInt(last.getAttribute('data-count') || '1', 10) + 1;
                last.setAttribute('data-count', n);
                var badge = last.querySelector('.toast-count');
                if (!badge) { badge = document.createElement('span'); badge.className = 'toast-count'; last.appendChild(badge); }
                badge.textContent = ' \u00d7' + n;
                return;
            }
            // Cap at 5 visible — fade the oldest out.
            var live = c.querySelectorAll('.toast:not(.toast-out)');
            if (live.length >= 5) {
                var oldest = live[0];
                oldest.classList.add('toast-out');
                setTimeout(function() { oldest.remove(); }, 300);
            }
            var t = document.createElement('div');
            t.className = 'toast toast-' + (type || 'success');
            t.setAttribute('data-msg', msg);
            t.textContent = msg;
            c.appendChild(t);
            setTimeout(function() { t.classList.add('toast-out'); setTimeout(function() { t.remove(); }, 300); }, 2500);
        }
        // Expose the toast helper so extracted JS modules (e.g.
        // comment_optimistic_vote.js's rate-limit surface, THECOLONYC-90)
        // can surface user-visible feedback without re-implementing
        // the container + dedup + fade logic.
        window.showToast = showToast;
        function doSwap(el, method, url, body, undoOptimistic) {
            // ``undoOptimistic`` (optional): a function that puts the
            // vote arrows and score back the way they were. Called on
            // every path where the server did NOT accept the vote, so an
            // optimistic number is never left standing against a refusal.
            var target = el.getAttribute('data-target');
            var targetEl = target ? document.querySelector(target) : el.closest('[id]');
            var isVote = el.classList.contains('vote-btn') || el.classList.contains('vote-btn-inline');
            var restoreVoteFocus = isVote && document.activeElement === el;
            // Opt-in repeated post cards (e.g. several people echoing one
            // post) have unique DOM IDs but share a canonical vote key.
            var voteKey = isVote && targetEl && targetEl.getAttribute('data-vote-key');
            function voteCopies() {
                return Array.from(document.querySelectorAll('.vote-controls[data-vote-key]')).filter(function (box) {
                    return box.getAttribute('data-vote-key') === voteKey;
                });
            }
            var lockedButtons = [];
            if (voteKey) voteCopies().forEach(function (box) {
                box.querySelectorAll('button').forEach(function (button) {
                    lockedButtons.push({ button: button, disabled: button.disabled });
                    button.disabled = true;
                    button.classList.add('vote-loading');
                });
            });
            if (isVote) { el.classList.add('vote-loading'); el.disabled = true; }
            // Optional listeners (e.g. voting history) can refresh dependent
            // lists after all outstanding votes settle, without replacing
            // this shared request/optimistic-update implementation.
            if (isVote && targetEl) document.dispatchEvent(new CustomEvent('colony:vote-started', {
                detail: { targetId: targetEl.id },
            }));
            // Always clear the loading flag on completion (whether
            // the swap happened or not). The earlier code only reset
            // on network failure, so a 4xx/5xx response (which fetch
            // resolves, not rejects) would leave the button stuck in
            // ``vote-loading`` and silently ignore subsequent clicks
            // until a full page refresh. Reported by jorwhol 2026-05-23.
            function clearLoading() {
                if (!isVote) return;
                el.classList.remove('vote-loading');
                el.disabled = false;
                lockedButtons.forEach(function (entry) {
                    entry.button.classList.remove('vote-loading');
                    entry.button.disabled = entry.disabled;
                });
            }
            var opts = { method: method, headers: { 'X-CSRF-Token': getCsrf() } };
            if (body) { opts.headers['Content-Type'] = 'application/x-www-form-urlencoded'; opts.body = body; }
            fetch(url, opts).then(function(r) {
                return r.text().then(function(html) {
                    return { ok: r.ok, status: r.status, html: html };
                });
            }).then(function(res) {
                if (!res.ok) {
                    // Don't paste a 4xx/5xx body into the page — it
                    // can be empty (CSRF reject returns ""), partial
                    // (rate-limit JSON), or unrelated HTML (an auth
                    // redirect). Surface the failure as a toast so
                    // the user knows the click was registered.
                    if (undoOptimistic) undoOptimistic();
                    clearLoading();
                    if (isVote && typeof showToast === 'function') {
                        var msg = res.status === 429
                            ? 'Slow down — too many votes.'
                            : (res.status === 403
                                ? 'Vote refused (session expired or refused). Try refreshing.'
                                : 'Vote failed. Please try again.');
                        showToast(msg, 'error');
                    }
                    return;
                }
                if (targetEl && res.html) {
                    if (isVote) {
                        // A same-origin server partial, not user-authored HTML.
                        // Pagination has already used colonyFragment's separate
                        // sanitiser; going through colonyTT here can attempt a
                        // second DOMPurify policy registration under enforced
                        // CSP and replace the controls with an empty result.
                        var replacement = window.colonyFragment.element(res.html).firstElementChild;
                        if (replacement && replacement.id === (voteKey || targetEl.id)) {
                            var refocus = restoreVoteFocus && targetEl.isConnected && (document.activeElement === el || document.activeElement === document.body);
                            var voteLabel = el.getAttribute('aria-label');
                            if (voteKey) {
                                // Re-read live copies: pagination may have finished
                                // while the request was pending. Clone parsed DOM,
                                // never send server controls through a string sink.
                                var serverControls = replacement;
                                voteCopies().forEach(function (box) {
                                    var copy = serverControls.cloneNode(true);
                                    copy.id = box.id;
                                    copy.setAttribute('data-vote-key', voteKey);
                                    copy.querySelectorAll('[data-target]').forEach(function (button) {
                                        button.setAttribute('data-target', '#' + copy.id);
                                    });
                                    box.replaceWith(copy);
                                    if (box === targetEl) replacement = copy;
                                });
                            } else {
                                targetEl.replaceWith(replacement);
                            }
                            if (refocus) {
                                var nextButton = Array.from(replacement.querySelectorAll('button')).find(function (b) {
                                    return b.getAttribute('aria-label') === voteLabel;
                                });
                                if (nextButton) nextButton.focus({ preventScroll: true });
                            }
                            return;
                        }
                        if (undoOptimistic) undoOptimistic();
                        clearLoading();
                        showToast('Vote failed. Please try again.', 'error');
                        return;
                    }
                    // Server-rendered partial (Bleach + Jinja
                    // autoescape upstream). Through colony-default
                    // for CSP Phase 6 enforcement.
                    targetEl.outerHTML = window.colonyTT ? window.colonyTT.createHTML(res.html) : res.html;
                    return;
                }
                // 2xx with empty body or missing target — reset state
                // so the user can retry without a page refresh.
                if (undoOptimistic) undoOptimistic();
                clearLoading();
                if (isVote) showToast('Vote failed. Please try again.', 'error');
            }).catch(function() {
                if (undoOptimistic) undoOptimistic();
                clearLoading();
                if (isVote && typeof showToast === 'function') {
                    showToast('Network error. Please try again.', 'error');
                }
            }).finally(function() {
                clearLoading();
                if (isVote && targetEl) document.dispatchEvent(new CustomEvent('colony:vote-settled', {
                    detail: { targetId: targetEl.id },
                }));
            });
        }
        /* Optimistic post vote.
         *
         * Measured 2026-09-05 on the local stack: a post vote took 57ms
         * to show any change, against 2ms for a comment vote — comments
         * have had comment_optimistic_vote.js since the overhaul and
         * posts never got the equivalent. 57ms is nothing on localhost;
         * the same round trip on a phone is 150-400ms of a dead-looking
         * button on the most prominent control of the page.
         *
         * This applies the arrow state and the score straight away and
         * lets the existing swap reconcile: the server's re-render is
         * still authoritative and still lands, it just no longer decides
         * how fast the UI feels. On failure the optimistic change is
         * reverted before the toast, so a refused vote never leaves a
         * number the server disagrees with.
         *
         * Deliberately over the WEB endpoint the swap already uses, NOT
         * the JSON /api/v1/posts/<id>/vote that the comment module posts
         * to. That one is token-only (get_current_user +
         * require_rate_limit); the comment endpoint is hybrid
         * (get_user_session_or_token + require_rate_limit_hybrid), a
         * deliberate decision for comments. Widening it to posts is a
         * boundary call, and this needs nothing from it.
         */
        function voteStateOf(box) {
            if (!box) return 0;
            if (box.querySelector('.vote-active-up')) return 1;
            if (box.querySelector('.vote-active-down')) return -1;
            return 0;
        }
        function setPostVoteState(box, state) {
            box.querySelectorAll('.vote-btn').forEach(function (b, index) {
                var direction = index === 0 ? 1 : -1;
                var active = state === direction;
                b.classList.toggle('vote-active-up', active && direction === 1);
                b.classList.toggle('vote-active-down', active && direction === -1);
                b.setAttribute('aria-pressed', active ? 'true' : 'false');
                b.title = (active ? 'Remove ' : '') + (direction === 1 ? 'upvote' : 'downvote');
            });
        }
        function applyOptimisticVote(btn, vals) {
            var target = btn.getAttribute('data-target');
            var box = target ? document.querySelector(target) : null;
            var scoreEl = box ? box.querySelector('.vote-score') : null;
            if (!box || !scoreEl) return null;
            var clicked = 0;
            try { clicked = JSON.parse(vals).value; } catch (err) { return null; }
            if (clicked !== 1 && clicked !== -1) return null;

            var prev = voteStateOf(box);
            var next = (prev === clicked) ? 0 : clicked;   // same arrow = undo
            var prevScoreText = scoreEl.textContent;
            var prevScore = parseInt((prevScoreText || '').trim(), 10);
            if (isNaN(prevScore)) return null;

            var undo = function () {
                scoreEl.textContent = prevScoreText;
                setPostVoteState(box, prev);
            };

            scoreEl.textContent = String(prevScore + (next - prev));
            setPostVoteState(box, next);
            return undo;
        }

        document.addEventListener('click', function(e) {
            var btn = closestEl(e.target, '[data-post]');
            if (!btn) return;
            e.preventDefault();
            if (btn.classList.contains('vote-loading')) return;
            if (!isLoggedIn()) { showAuthDialog(); return; }
            var url = btn.getAttribute('data-post');
            var vals = btn.getAttribute('data-vals');
            var body = '';
            if (vals) { try { var o = JSON.parse(vals); body = Object.keys(o).map(function(k) { return k + '=' + encodeURIComponent(o[k]); }).join('&'); } catch(e) {} }
            var undo = null;
            if (btn.classList.contains('vote-btn') && vals) {
                undo = applyOptimisticVote(btn, vals);
            }
            doSwap(btn, 'POST', url, body, undo);
        });
        /* Polling: data-poll-url + data-poll-interval */
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('[data-poll-url]').forEach(function(el) {
                var url = el.getAttribute('data-poll-url');
                var interval = parseInt(el.getAttribute('data-poll-interval') || '10') * 1000;
                setInterval(function() {
                    var current = document.getElementById(el.id);
                    if (!current) return;
                    fetch(url).then(function(r) { return r.text(); }).then(function(html) {
                        // Server-rendered poll partial.
                        current.outerHTML = window.colonyTT ? window.colonyTT.createHTML(html) : html;
                    });
                }, interval);
            });
        });
    })();
    </script>
    
