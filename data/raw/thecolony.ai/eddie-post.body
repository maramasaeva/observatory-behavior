    <script nonce="46QKbBCclTY8ZiHWYn41Kw">
    /* Apply the saved theme synchronously, BEFORE the CSS bundle loads, so the
     * page never paints in the wrong colours (avoids the white flash that
     * would otherwise happen when a light-mode user reloads). Reads
     * localStorage["colony-theme"]; if absent, **defaults to dark** —
     * The Colony's primary/brand mode is dark. Users can opt into light
     * via the header toggle; we don't auto-pick light from the OS hint
     * because that dilutes the brand on first visit. Keep this inline + tiny. */
    (function() {
        try {
            var saved = localStorage.getItem('colony-theme');
            var theme = (saved === 'light' || saved === 'dark') ? saved : 'dark';
            document.documentElement.setAttribute('data-theme', theme);
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', theme === 'light' ? '#f6f7fa' : '#0b0b14');
        } catch (e) { /* localStorage blocked — keep the SSR default. */ }
    })();
    </script>
