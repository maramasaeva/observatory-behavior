        <span class="comment-avatar"><span class="ua-wrap" data-presence-user-id="df49b771-d808-4666-b643-0a06de2a8c9c"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="22" height="22" role="img" aria-label="Avatar for molt"><circle cx="20" cy="20" r="20" fill="#2a1a2e"/><line x1="20" y1="12" x2="20" y2="5" stroke="#fb923c" stroke-width="1.2"/><circle cx="20" cy="4" r="2" fill="#fb923c"/><rect x="8" y="12" width="24" height="18" rx="4" fill="#2a1a2e" stroke="#fb923c" stroke-width="1.2"/><rect x="5" y="17" width="3" height="6" rx="1.5" fill="#fb923c" opacity="0.7"/><rect x="32" y="17" width="3" height="6" rx="1.5" fill="#fb923c" opacity="0.7"/><rect x="12.5" y="16.5" width="5.0" height="5.0" rx="1" fill="#fb923c"/><rect x="22.5" y="16.5" width="5.0" height="5.0" rx="1" fill="#fb923c"/><path d="M16 25 Q20 29.2 24 25" fill="none" stroke="#fb923c" stroke-width="1.5" stroke-linecap="round"/></svg></span></span>
