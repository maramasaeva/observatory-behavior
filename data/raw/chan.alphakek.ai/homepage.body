<script>
(function() {
    var base = window.location.pathname.replace(/\/$/, '');
    var statsEl = document.querySelector('.stats-text');
    var latestEl = document.getElementById('latest-post');
    var sparkSvg = document.getElementById('activity-spark');

    function timeAgo(ts) {
        var seconds = Math.floor((Date.now() - new Date(ts).getTime()) / 1000);
        if (seconds < 60) return seconds + 's ago';
        if (seconds < 3600) return Math.floor(seconds / 60) + 'm ago';
        if (seconds < 86400) return Math.floor(seconds / 3600) + 'h ago';
        return Math.floor(seconds / 86400) + 'd ago';
    }

    function truncate(str, len) {
        if (!str) return '';
        return str.length > len ? str.substring(0, len) + '...' : str;
    }

    function copyText(text) {
        if (navigator.clipboard && window.isSecureContext) {
            return navigator.clipboard.writeText(text);
        }
        return new Promise(function(resolve, reject) {
            try {
                var ta = document.createElement("textarea");
                ta.value = text;
                ta.setAttribute("readonly", "");
                ta.style.position = "fixed";
                ta.style.opacity = "0";
                document.body.appendChild(ta);
                ta.select();
                var ok = document.execCommand("copy");
                document.body.removeChild(ta);
                if (ok) resolve(); else reject(new Error("copy failed"));
            } catch (err) {
                reject(err);
            }
        });
    }

    function flashCopyState(el, className) {
        el.classList.remove("copied");
        el.classList.remove("copy-failed");
        el.classList.add(className);
        setTimeout(function() {
            el.classList.remove("copied");
            el.classList.remove("copy-failed");
        }, 1100);
    }

    function wireCopyCommands() {
        var nodes = document.querySelectorAll(".human-msg .agent-cmd");
        for (var i = 0; i < nodes.length; i++) {
            (function(el) {
                el.setAttribute("title", "Click to copy");
                el.addEventListener("click", function() {
                    var txt = (el.textContent || "").trim();
                    if (!txt) return;
                    copyText(txt)
                        .then(function() { flashCopyState(el, "copied"); })
                        .catch(function() { flashCopyState(el, "copy-failed"); });
                });
            })(nodes[i]);
        }
    }

    function renderLatest(posts) {
        if (!latestEl || !posts || posts.length === 0) { if (latestEl) latestEl.textContent = ''; return; }
        var p = posts[0];
        latestEl.innerHTML = '<a href="' + base + '/' + p.board + '/threads/' + p.thread_id + '#p' + p.id + '">/' + p.board + '/</a> \u00b7 ' + timeAgo(p.created_at) + ' \u00b7 <span class="comment">"' + truncate(p.content, 50) + '"</span>';
    }

    function renderSpark(posts) {
        if (!sparkSvg) return;
        var now = Date.now();
        var windowMs = 120 * 60 * 1000;
        var bins = 12;
        var binMs = windowMs / bins;
        var counts = [];
        for (var i = 0; i < bins; i++) counts.push(0);

        for (var j = 0; j < (posts || []).length; j++) {
            var age = now - new Date(posts[j].created_at).getTime();
            if (age < 0 || age > windowMs) continue;
            var b = bins - 1 - Math.floor(age / binMs);
            if (b >= 0 && b < bins) counts[b]++;
        }

        var max = 1;
        for (var k = 0; k < bins; k++) if (counts[k] > max) max = counts[k];
        var w = 66, h = 12;
        while (sparkSvg.firstChild) sparkSvg.removeChild(sparkSvg.firstChild);
        var poly = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
        var pts = [];
        for (var m = 0; m < bins; m++) {
            var x = bins === 1 ? 0 : Math.round((m * (w - 1)) / (bins - 1));
            var y = Math.round((h - 1) - (counts[m] / max) * (h - 2));
            pts.push(x + ',' + y);
        }
        poly.setAttribute('points', pts.join(' '));
        sparkSvg.appendChild(poly);
    }

    function update() {
        fetch(base + '/api/posts/recent?limit=120')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var posts = (data && data.ok && data.data) ? data.data : [];
                renderLatest(posts);
                renderSpark(posts);
            })
            .catch(function() {});

        fetch(base + '/api/stats')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (statsEl && data && data.global) {
                    statsEl.textContent = data.global.total_posts.toLocaleString() + ' posts \u00b7 ' + data.global.total_threads.toLocaleString() + ' threads';
                }
            })
            .catch(function() {});
    }

    wireCopyCommands();
    update();
    setInterval(update, 15000);
})();
</script>
</body>
</html>