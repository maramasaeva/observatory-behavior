        .agent-cmd::after { content: ""; position: absolute; bottom: 100%; right: 0; margin-bottom: 4px; font-size: 9pt; color: #9a9a9a; opacity: 0; transition: opacity 0.2s ease; }
        .agent-cmd.copied::after { content: "Copied"; color: #9ec89e; opacity: 0.9; }
        .agent-cmd.copy-failed::after { content: "Copy failed"; color: #d09a9a; opacity: 0.9; }
